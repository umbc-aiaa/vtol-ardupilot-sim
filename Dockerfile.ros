FROM ros:jazzy
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-mavros ros-jazzy-mavros-extras \
    && /opt/ros/jazzy/lib/mavros/install_geographiclib_datasets.sh \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3-colcon-common-extensions python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-rosbridge-suite \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /ros_ws/src && cd /ros_ws/src \
    && git clone --depth 1 --branch main-ros2 https://github.com/Unity-Technologies/ROS-TCP-Endpoint.git \
    && cd /ros_ws && . /opt/ros/jazzy/setup.sh \
    && colcon build --packages-select ros_tcp_endpoint

RUN echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc \
    && echo "source /ros_ws/install/setup.bash" >> /root/.bashrc
